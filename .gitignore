# Google Sheets OAuth secrets for tools/steering_to_gsheet.py.
# Token auto-refreshes; both files are user-specific and never
# belong in git.  Canonical path is
# ~/.config/assistant-axis/google_{credentials,token}.json,
# but the patterns are scoped tree-wide in case someone drops a
# copy in the repo by accident.
**/google_credentials.json
**/google_token.json

# Outputs
outputs/
*.parquet

# OS
.DS_Store
Thumbs.db
/data/traits original-examples copy
/data_backup
/runpod_workspace
/roger
/christina_axes

# Claude Code agent worktrees
/.claude/worktrees/

# Trait-gap generation platform (reports/trait_gap_generation/coding_plan_platform.md)
# External downloads (Open English WordNet, HF models) stay in-tree but untracked.
/data/external/
# Embedding cache (M2).
/data/candidates/cache/
# The live registry log is gitignored; `gap_registry.py compact` writes the
# tracked snapshot data/candidates/registry.snapshot.jsonl (review amendment 3).
/data/candidates/registry.jsonl
/data/candidates/registry.jsonl.bak.*
/data/candidates/*.lock
/data/candidates/runs/**/.run.lock
/data/candidates/*.tmp
