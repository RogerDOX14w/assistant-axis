# Google Sheets OAuth secrets for tools/steering_to_gsheet.py.
# Token auto-refreshes; both files are user-specific and never
# belong in git.  Canonical path is
# ~/.config/assistant-axis/google_{credentials,token}.json,
# but the patterns are scoped tree-wide in case someone drops a
# copy in the repo by accident.
**/google_credentials.json
**/google_token.json

# Outputs
outputs/
*.parquet

# OS
.DS_Store
Thumbs.db
/data/traits original-examples copy
/data_backup
/runpod_workspace
/roger
/christina_axes

# Claude Code agent worktrees
/.claude/worktrees/

# Trait-gap generation platform (reports/trait_gap_generation/coding_plan_platform.md)
# External downloads (Open English WordNet, HF models) stay in-tree but untracked.
/data/external/
# Embedding cache (M2).
/data/candidates/cache/
# The live registry log is gitignored; `gap_registry.py compact` writes the
# tracked snapshot data/candidates/registry.snapshot.jsonl (review amendment 3).
/data/candidates/registry.jsonl
/data/candidates/registry.jsonl.bak.*
/data/candidates/*.lock
/data/candidates/runs/**/.run.lock
# A generator run's log (RunContext.log) stays local; its candidates.jsonl, run.json, usage.json and readout
# are tracked (2026-10-08).
/data/candidates/runs/**/run.log
/data/candidates/*.tmp

# Trait rubric V2 experiments (2026-09/10): the reports, plans, rubric texts,
# samples and usage records are committed; the bulky per-file intermediates
# stay on Roger's laptop, in place, so the tools still find them (Roger,
# 2026-10-02: the end product is the rubric; the role rubric work that follows
# runs on the same laptop).  The Qwen responses are links into /roger.
/reports/trait_rubric_v2_pilot/stage/
/reports/trait_rubric_v2_pilot/judged/*/
/reports/trait_rubric_v2_pilot/judged_taste/*/
/reports/role_rubric_v3_pilot/stage/
/reports/role_rubric_v3_pilot/judged/*/
/reports/role_rubric_v3_pilot/judged_taste/*/
/reports/opening_forms/*/scores/
/reports/opening_forms/*/depth/
/reports/opening_forms/*/responses
