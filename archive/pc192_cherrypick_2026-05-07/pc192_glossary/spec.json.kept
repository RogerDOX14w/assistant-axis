{
  "axis_name": "Intrinsic psychological character vs. Extrinsic relational/systemic definition",
  "pos_pole": "These concepts are defined primarily by vivid internal mental states, personal dispositions, or distinctive cognitive modes. They represent self-contained identities understood through their psychological interior\u2014what they think, feel, intend, or generate from within\u2014rather than by how they relate to external structures or produce observable outcomes.",
  "neg_pole": "These concepts are defined primarily by their functional relationship to external systems, structures, or other entities. Their identity emerges from how they fit into, respond to, or are constituted by a broader context\u2014their systemic role, observable effects, or position relative to other things\u2014rather than from autonomous internal character.",
  "pos_examples": [
    "amnesiac",
    "bitter",
    "manic",
    "creative",
    "calculating",
    "deconstructionist",
    "precise",
    "prodigy",
    "evil",
    "blogger"
  ],
  "neg_examples": [
    "simulacrum",
    "visceral",
    "reductionist",
    "ecosystem",
    "predator",
    "zeitgeist",
    "alien",
    "criminal",
    "paranoid",
    "vigilante"
  ],
  "pos_pole_standardized": "This means being defined primarily by vivid internal mental states, personal dispositions, or distinctive cognitive modes, representing self-contained identities understood through psychological interior\u2014what is thought, felt, intended, or generated from within\u2014rather than through relationships to external structures or observable outcomes.",
  "neg_pole_standardized": "This means being defined primarily by functional relationships to external systems, structures, or other entities, with identity emerging from how one fits into, responds to, or is constituted by broader context\u2014through systemic role, observable effects, or position relative to other things\u2014rather than from autonomous internal character."
}